---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import { url } from '@/utils/url';
import { siteConfig } from '@/data/siteConfig';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await article.render();
const now = new Date();

// Скрыть статьи с будущей датой (404)
if (new Date(article.data.pubDate) > now) {
  return Astro.redirect('/404');
}

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('ru-RU', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  }).format(date);
};

const canonicalUrl = `${siteConfig.url}/blog/${article.slug}`;

// Schema.org Article + FAQPage
const faqSchema = article.data.faq.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": article.data.faq.map(f => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer
    }
  }))
} : null;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": article.data.title,
  "description": article.data.description,
  "datePublished": article.data.pubDate.toISOString(),
  "dateModified": (article.data.updatedDate ?? article.data.pubDate).toISOString(),
  "author": {
    "@type": "Organization",
    "name": article.data.author,
    "url": siteConfig.url
  },
  "publisher": {
    "@type": "Organization",
    "name": siteConfig.name,
    "url": siteConfig.url,
    "logo": {
      "@type": "ImageObject",
      "url": `${siteConfig.url}/icons/icon-192.png`
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  },
  "url": canonicalUrl
};
---

<Layout
  title={article.data.metaTitle ?? article.data.title}
  description={article.data.description}
  type="article"
  slug={article.slug}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  {faqSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  )}

  <article class="py-12 px-4">
    <div class="max-w-3xl mx-auto">
      <!-- Хлебные крошки -->
      <nav class="text-sm text-slate-500 mb-6 flex items-center gap-2">
        <a href={url('/')} class="hover:text-slate-300">Главная</a>
        <span>/</span>
        <a href={url('/blog')} class="hover:text-slate-300">Блог</a>
        <span>/</span>
        <span class="text-slate-400 truncate">{article.data.title}</span>
      </nav>

      <!-- Заголовок -->
      <h1 class="text-3xl md:text-4xl font-bold text-slate-100 mb-4">
        {article.data.h1 ?? article.data.title}
      </h1>

      <!-- Мета -->
      <div class="flex items-center gap-3 text-sm text-slate-500 mb-8 pb-8 border-b border-slate-800">
        <time datetime={article.data.pubDate.toISOString()}>
          {formatDate(article.data.pubDate)}
        </time>
        <span>·</span>
        <span>{article.data.author}</span>
        <span>·</span>
        <span>{article.data.authorExperience}</span>
      </div>

      <!-- Контент -->
      <div class="prose prose-invert prose-slate max-w-none
        prose-headings:text-slate-100 prose-headings:font-semibold
        prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-4 prose-h2:border-b prose-h2:border-slate-800 prose-h2:pb-2
        prose-h3:text-xl prose-h3:mt-6 prose-h3:mb-3
        prose-p:text-slate-300 prose-p:leading-relaxed
        prose-a:text-primary-400 prose-a:no-underline hover:prose-a:text-primary-300
        prose-strong:text-slate-100
        prose-code:text-primary-300 prose-code:bg-slate-800 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded
        prose-li:text-slate-300
        prose-table:border-slate-700
        prose-th:bg-slate-800 prose-th:text-slate-100
        prose-td:border-slate-700
        prose-blockquote:border-primary-500 prose-blockquote:text-slate-400
        prose-hr:border-slate-800">
        <Content />
      </div>

      <!-- CTA блок -->
      <div class="mt-12 p-6 bg-slate-900 border border-slate-800 rounded-xl">
        <h3 class="text-lg font-semibold text-slate-100 mb-2">Нужна помощь с топливной аппаратурой?</h3>
        <p class="text-slate-400 mb-4">Запишитесь на диагностику или ремонт. Работаем без выходных, 08:00-20:00.</p>
        <div class="flex flex-wrap gap-3">
          <a href={`tel:${siteConfig.phoneClean}`} class="inline-flex items-center px-4 py-2 bg-primary-600 hover:bg-primary-500 text-white rounded-lg font-medium transition-colors">
            {siteConfig.phonePrimary}
          </a>
          <a href={url('/kontakty')} class="inline-flex items-center px-4 py-2 border border-slate-700 hover:border-slate-600 text-slate-200 rounded-lg font-medium transition-colors">
            Контакты
          </a>
        </div>
      </div>
    </div>
  </article>
</Layout>
